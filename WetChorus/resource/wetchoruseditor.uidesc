<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
	<fonts>
		<font name="TinyFont" font-name="Arial" size="0"/>
	</fonts>

	<colors>
		<color name="Transparent" rgba="#00000000"/>
	</colors>

	<control-tags>
		<control-tag name="kSpeedParam" tag="0"/>
		<control-tag name="kDepthParam" tag="1"/>
		<control-tag name="kModeParam" tag="2"/>
		<control-tag name="kInMeter" tag="3"/>
		<control-tag name="kOutMeterL" tag="4"/>
		<control-tag name="kOutMeterR" tag="5"/>
	</control-tags>

	<!-- Generated by tools/make-assets-wetchorus.py from the panel art.
	     Do not hand-edit: re-run the script instead, so the geometry here
	     stays tied to the measured positions of the painted controls. -->
	<template background-color="~ BlackCColor"
	          bitmap="backplate"
	          class="CViewContainer"
	          name="view"
	          size="768, 512"
	          transparent="false">

		<!-- One IN strip and a stereo OUT pair. The asymmetry is the point:
		     the input is summed to mono and the stereo image is made by the
		     circuit, so there is one in and two out. -->
		<view class="LEDMeterView"
		      control-tag="kInMeter"
		      origin="485, 192"
		      size="21, 185"
		      num-segments="16"
		      segment-gap="3"
		      horizontal="false"
		      transparent="false"/>

		<view class="LEDMeterView"
		      control-tag="kOutMeterL"
		      origin="620, 192"
		      size="21, 185"
		      num-segments="16"
		      segment-gap="3"
		      horizontal="false"
		      transparent="false"/>

		<view class="LEDMeterView"
		      control-tag="kOutMeterR"
		      origin="682, 192"
		      size="20, 185"
		      num-segments="16"
		      segment-gap="3"
		      horizontal="false"
		      transparent="false"/>

		<!-- SPEED, DEPTH and MODE. Seventeen detents, one per painted dot,
		     opening to sixty-five with Shift held. -->
		<view class="ChorusKnob"
		      control-tag="kSpeedParam"
		      origin="34, 178"
		      size="131, 131"
		      bitmap="knob_speed"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="ChorusKnob"
		      control-tag="kModeParam"
		      origin="296, 178"
		      size="131, 131"
		      bitmap="knob_mode"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<!-- DEPTH: a latching button. Two states, so not a knob - a
		     two-position control on the seventeen-dot arc the other knobs
		     use would make fifteen of those dots lie. Engaged, it takes a
		     red ring, which is how WetDelay marks its active button. -->
		<view class="DepthSwitch"
		      control-tag="kDepthParam"
		      origin="185, 159"
		      size="94, 136"
		      bitmap="depth_button"
		      button-rect="20.0,51.5,74.0,126.5"
		      led-spot="38,22,57,41"
		      led-bitmap="depth_led"
		      glow-spot="18,2,77,61"
		      glow-bitmap="depth_glow"
		      frame-rect="0,42,94,136"
		      transparent="true"/>

	</template>

	<custom>
		<attributes name="FocusDrawing"/>
		<attributes Path="wetchoruseditor.uidesc" name="VST3Editor"/>
	</custom>

	<bitmaps>
		<bitmap name="backplate" path="backplate.png"/>
		<bitmap name="depth_led" path="depth_led.png"/>
		<bitmap name="depth_glow" path="depth_glow.png"/>
		<bitmap name="knob_speed" path="knob_speed.png"
		        multiframe-size="131, 131"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_mode" path="knob_mode.png"
		        multiframe-size="131, 131"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="depth_button" path="depth_button.png"/>
	</bitmaps>
</vstgui-ui-description>
